---
import Avatar from '../../components/ui/Avatar.astro';
import ChampionIcon from '../../components/ui/ChampionIcon.astro';
import Panel from '../../components/ui/Panel.astro';
import RoleIcon from '../../components/ui/RoleIcon.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { db } from '../../lib/db/db';
import { formatDate, formatPercent, formatKda, pluralize } from '../../lib/format';
import { championName, profileIcon, roleLabel } from '../../lib/lol';
import { getIndividualProfiles, getPlayers } from '../../lib/stats';

export const prerender = false;

const puuid = Astro.params.puuid ?? '';
const profile = getIndividualProfiles(db).find((player) => player.puuid === puuid);
if (!profile) return new Response('Joueur introuvable.', { status: 404 });
const teamProfile = getPlayers(db).find((player) => player.puuid === puuid);
const recentMatches = [...profile.soloDuo.recentMatches, ...profile.flex.recentMatches]
	.sort((left, right) => right.startedAt - left.startedAt || left.id.localeCompare(right.id))
	.slice(0, 20);
const rankQueues = [
	{ label: 'Solo / Duo', activity: profile.soloDuo },
	{ label: 'Flex', activity: profile.flex },
];
---

<BaseLayout title={`${profile.name} — parcours personnel | etoiles.win`} description={`Parcours classé personnel de ${profile.name}, séparé des statistiques collectives des Étoiles de l’Esport.`}>
	<main class="mx-auto flex w-full max-w-7xl flex-1 flex-col gap-12 px-4 py-10 sm:px-8 sm:py-14">
		<nav aria-label="Fil d’Ariane">
			<a href="/#roster-title" class="focus-ring text-sm text-muted transition-colors hover:text-ink">← Retour aux cinq Étoiles</a>
		</nav>

		<header class="flex flex-col gap-6 border-b border-white/10 pb-8 sm:flex-row sm:items-center">
			<Avatar src={profileIcon(profile.puuid)} class="size-24 sm:size-28" />
			<div>
				<p class="label-caps text-sky-300">Un parcours, jamais un classement</p>
				<h1 class="mt-2 font-display text-4xl text-ink sm:text-5xl">{profile.name}</h1>
				{profile.tagLine && <p class="mt-1 text-sm text-muted">#{profile.tagLine}</p>}
				<p class="mt-4 max-w-2xl text-sm leading-relaxed text-muted">
					Ses parties classées Solo/Duo et Flex, son pool de champions et son évolution de rang. Ce parcours est personnel et n’est pas comparé à ceux des autres joueurs.
				</p>
			</div>
		</header>

		<section aria-labelledby="rank-heading">
			<div class="mb-5">
				<p class="label-caps text-sky-300">Repères de progression</p>
				<h2 id="rank-heading" class="mt-2 font-display text-3xl text-ink">Le rang dans le temps</h2>
			</div>
			<div class="grid gap-4 md:grid-cols-2">
				{rankQueues.map(({ label, activity }) => (
					<Panel as="article" class="p-5 sm:p-7">
						<p class="label-caps text-muted">Classé {label}</p>
						{
							activity.currentRank ? (
								<>
									<p class="mt-3 font-display text-2xl text-ink">
										{activity.currentRank.tier
											? `${activity.currentRank.tier} ${activity.currentRank.division ?? ''}`.trim()
											: 'Non classé au dernier relevé'}
									</p>
									<p class="mt-2 text-sm text-muted">
										Relevé du {activity.currentRank.capturedOn}
										{activity.currentRank.leaguePoints !== null && ` · ${activity.currentRank.leaguePoints} LP`}
									</p>
									{activity.currentRank.wins !== null && activity.currentRank.losses !== null && (
										<p class="mt-2 text-xs text-muted">
											{activity.currentRank.wins} victoires · {activity.currentRank.losses} défaites au moment du relevé
										</p>
									)}
								</>
							) : (
								<p class="mt-3 max-w-sm text-sm leading-relaxed text-muted">
									Aucun snapshot enregistré. Le suivi commence à la prochaine synchronisation quotidienne; aucun rang antérieur n’est reconstitué.
								</p>
							)
						}
						{activity.rankHistory.length > 1 && (
							<ol class="mt-5 flex flex-wrap gap-2 border-t border-white/10 pt-4">
								{activity.rankHistory.map((snapshot) => (
									<li class="border border-white/10 px-2.5 py-1.5 text-xs text-muted">
										<time datetime={snapshot.capturedOn}>{snapshot.capturedOn}</time>
										<span class="ml-2 text-ink">{snapshot.tier ? `${snapshot.tier} ${snapshot.division ?? ''}` : 'Non classé'}</span>
									</li>
								))}
							</ol>
						)}
					</Panel>
				))}
			</div>
		</section>

		<section aria-labelledby="ranked-history-heading">
			<div class="mb-5">
				<p class="label-caps text-sky-300">Comprendre son jeu</p>
				<h2 id="ranked-history-heading" class="mt-2 font-display text-3xl text-ink">Deux files, deux histoires.</h2>
			</div>
			<div class="grid gap-4 lg:grid-cols-2">
				{rankQueues.map(({ label, activity }) => (
					<Panel as="article" class="p-5 sm:p-7">
						<div class="flex flex-wrap items-end justify-between gap-4">
							<div>
								<p class="label-caps text-muted">{label}</p>
								<p class="mt-2 font-display text-3xl text-ink">{pluralize(activity.games, 'partie')}</p>
							</div>
							{activity.winRate !== null && (
								<p class="text-right text-sm text-muted">
									<span class="font-display text-2xl text-gold-200">{formatPercent(activity.winRate)}</span><br />
									{activity.wins} victoires sur {activity.games}
								</p>
							)}
						</div>
						{
							activity.games === 0 ? (
								<p class="mt-6 border-t border-white/10 pt-5 text-sm leading-relaxed text-muted">
									Aucune partie de cette file n’est enregistrée pour le moment. La collecte est incrémentale et ne concerne que le classé.
								</p>
							) : (
								<>
									{activity.champions.length > 0 && (
										<div class="mt-6 border-t border-white/10 pt-5">
											<p class="label-caps text-muted">Champions joués · échantillon affiché avec son volume</p>
											<ul class="mt-4 flex flex-wrap gap-3">
												{activity.champions.slice(0, 8).map((champion) => (
													<li class="flex items-center gap-2 border border-white/8 bg-night-950/40 py-1.5 pr-3 pl-1.5">
														<ChampionIcon champion={champion.champion} size="sm" />
														<span class="text-xs text-ink">{championName(champion.champion)}</span>
														<span class="text-xs tabular-nums text-muted">{champion.games}</span>
													</li>
												))}
											</ul>
										</div>
									)}
									{activity.roles.length > 0 && (
										<p class="mt-4 flex flex-wrap items-center gap-2 text-xs text-muted">
											Rôles les plus joués :
											{activity.roles.slice(0, 3).map((role) => (
												<span class="inline-flex items-center gap-1 text-ink">
													<RoleIcon role={role.role} class="size-4" /> {roleLabel(role.role)} · {role.games}
												</span>
											))}
										</p>
									)}
								</>
							)
						}
					</Panel>
				))}
			</div>
		</section>

		<section aria-labelledby="personal-matches-heading">
			<div class="mb-5">
				<p class="label-caps text-sky-300">Archives personnelles</p>
				<h2 id="personal-matches-heading" class="mt-2 font-display text-3xl text-ink">Les dernières parties classées</h2>
			</div>
			{
				recentMatches.length === 0 ? (
					<p class="border-l border-white/15 py-3 pl-5 text-sm text-muted">
						L’historique individuel sera visible ici au fil des synchronisations. Les parties collectives à cinq restent consultables dans la <a class="text-sky-300 underline" href="/history">mémoire de l’équipe</a>.
					</p>
				) : (
					<ol class="divide-y divide-white/8 border-y border-white/10">
						{recentMatches.map((match) => (
							<li>
								<a href={`/matches/${match.id}`} class="focus-ring grid grid-cols-[auto_minmax(0,1fr)_auto] items-center gap-4 py-3 transition-colors hover:bg-white/5 sm:grid-cols-[7rem_minmax(0,1fr)_8rem]">
									<span class:list={['font-display text-lg', match.outcome === 'win' ? 'text-gold-200' : 'text-grey-300']}>{match.outcome === 'win' ? 'Victoire' : 'Défaite'}</span>
									<span class="flex min-w-0 items-center gap-3">
										<ChampionIcon champion={match.champion} size="md" outcome={match.outcome} />
										<span class="flex min-w-0 flex-col">
											<span class="truncate text-sm text-ink">{championName(match.champion)} · {match.queue === 'soloDuo' ? 'Solo/Duo' : 'Flex'} · patch {match.patch}</span>
											<time datetime={new Date(match.startedAt).toISOString()} class="text-xs text-muted">{formatDate(match.startedAt)}</time>
										</span>
									</span>
									<span class="text-right text-xs tabular-nums text-muted">{formatKda(match.kills, match.deaths, match.assists)} <span class="sr-only">KDA</span></span>
								</a>
							</li>
						))}
					</ol>
				)
			}
		</section>

		{teamProfile && teamProfile.games > 0 && (
			<aside class="border-l border-gold-200/30 py-2 pl-5 sm:pl-7">
				<p class="label-caps text-gold-200">Mémoire collective</p>
				<p class="mt-2 max-w-2xl text-sm leading-relaxed text-muted">
					Cette page distingue son activité classée personnelle du collectif. {pluralize(teamProfile.games, 'match')} de son parcours avec les cinq sont déjà présents dans les statistiques de l’équipe.
				</p>
				<a href="/#collective-title" class="focus-ring mt-3 inline-block text-sm text-ink underline underline-offset-4">Retrouver les statistiques à cinq</a>
			</aside>
		)}
	</main>
</BaseLayout>
