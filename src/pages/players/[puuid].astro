---
import Avatar from '../../components/ui/Avatar.astro';
import ChampionIcon from '../../components/ui/ChampionIcon.astro';
import ChampionTile from '../../components/ui/ChampionTile.astro';
import MeterBar from '../../components/ui/MeterBar.astro';
import MotionItem from '../../components/ui/MotionItem.astro';
import OpggIcon from '../../components/ui/OpggIcon.astro';
import Panel from '../../components/ui/Panel.astro';
import QueueBadge from '../../components/ui/QueueBadge.astro';
import RankEmblem from '../../components/ui/RankEmblem.astro';
import RoleIcon from '../../components/ui/RoleIcon.astro';
import SegmentedNav from '../../components/ui/SegmentedNav.astro';
import StarPresence from '../../components/ui/StarPresence.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import MomentList from '../../components/memory/MomentList.astro';
import RankProgress from '../../components/players/RankProgress.astro';
import Discoveries from '../../components/collective/Discoveries.astro';
import { db } from '../../lib/db/db';
import { formatDecimal, formatKda, formatPercent, formatSince, formatShortDate, pluralize } from '../../lib/format';
import { championName, profileIcon, roleLabel, tierLabel } from '../../lib/lol';
import { SITE_NAME } from '../../lib/site';
import { getIndividualProfiles, getPlayers, getTeamStories, getDiscoveries, MIN_DRAFT_GAMES, type RankedMatch } from '../../lib/stats';

export const prerender = false;

const puuid = Astro.params.puuid ?? '';
const profile = getIndividualProfiles(db).find((player) => player.puuid === puuid);
if (!profile) return new Response('Joueur introuvable.', { status: 404 });
const teamProfile = getPlayers(db).find((player) => player.puuid === puuid);
const teamGames = teamProfile?.games ?? 0;
const teamWins = teamProfile?.champions.reduce((total, record) => total + record.wins, 0) ?? 0;

const params = Astro.url.searchParams;
const link = (key: string, value: string, anchor: string) => {
	const next = new URLSearchParams(params);
	next.set(key, value);
	return `?${next.toString()}#${anchor}`;
};

const championSorts = [
	{ value: 'games', label: 'Plus joués' },
	{ value: 'rate', label: `Winrate · ${MIN_DRAFT_GAMES}+` },
	{ value: 'recent', label: 'Récents' },
] as const;
type ChampionSort = (typeof championSorts)[number]['value'];
const championSort: ChampionSort = championSorts.find((sort) => sort.value === params.get('champions'))?.value ?? 'games';
const teamChampions = [...(teamProfile?.champions ?? [])].sort((left, right) => {
	if (championSort === 'recent') return right.lastPlayedAt - left.lastPlayedAt;
	if (championSort === 'rate') {
		const leftEligible = left.games >= MIN_DRAFT_GAMES;
		const rightEligible = right.games >= MIN_DRAFT_GAMES;
		if (leftEligible !== rightEligible) return leftEligible ? -1 : 1;
		if (leftEligible) {
			const difference = right.wins / right.games - left.wins / left.games;
			if (difference) return difference;
		}
	}
	return right.games - left.games || left.champion.localeCompare(right.champion);
});

const allRecent = [...profile.soloDuo.recentMatches, ...profile.flex.recentMatches]
	.sort((left, right) => right.startedAt - left.startedAt || left.id.localeCompare(right.id));
const matchFilters = [
	{ value: 'all', label: 'Toutes', test: () => true },
	{ value: 'five', label: 'À cinq', test: (match: RankedMatch) => match.teamSize >= 5 },
	{ value: 'group', label: 'En petit comité', test: (match: RankedMatch) => match.teamSize > 1 && match.teamSize < 5 },
	{ value: 'alone', label: 'Sans les Étoiles', test: (match: RankedMatch) => match.teamSize <= 1 },
] as const;
const matchFilter = matchFilters.find((filter) => filter.value === params.get('parties')) ?? matchFilters[0];
const recentMatches = allRecent.filter(matchFilter.test).slice(0, 20);

const queues = [
	{ key: 'soloDuo', label: 'Solo/Duo', activity: profile.soloDuo },
	{ key: 'flex', label: 'Flex', activity: profile.flex },
] as const;
const mainStat = teamProfile?.mainRole === 'UTILITY'
	? { label: 'Vision / min', value: teamProfile.visionPerMinute }
	: { label: 'CS / min', value: teamProfile?.csPerMinute ?? null };
const presenceTip = (match: RankedMatch) =>
	match.queue === 'flex' && match.teamSize >= 5 ? 'Comptée dans les bilans collectifs' : undefined;
const moments = getTeamStories(db).events.filter((moment) => moment.puuid === puuid);
const discoveries = getDiscoveries(db).filter((discovery) => discovery.puuid === puuid);
---

<BaseLayout title={`${profile.name} — ${SITE_NAME}`} description={`Les champions, les parties à cinq et le parcours classé de ${profile.name}.`}>
	<main class="mx-auto flex w-full max-w-7xl flex-1 flex-col gap-10 px-4 py-8 sm:px-8 sm:py-12">
		<a href="/#roster-title" class="focus-ring inline-flex w-fit items-center gap-2 text-sm text-muted transition-colors hover:text-ink">
			<OpggIcon name="ui-arrow-right" class="size-3 rotate-180" /> Les cinq Étoiles
		</a>

		<header class="grid items-center gap-6 border-b border-white/10 pb-8 sm:grid-cols-[auto_minmax(0,1fr)_auto]">
			<Avatar src={profileIcon(profile.puuid)} class="size-20 sm:size-24" />
			<div class="min-w-0">
				<h1 class="font-display text-4xl font-medium tracking-tight break-words text-ink sm:text-5xl">
					{profile.name}{profile.tagLine && <span class="ml-2 text-xl text-grey-700 sm:text-2xl">#{profile.tagLine}</span>}
				</h1>
				{teamProfile?.mainRole && (
					<p class="mt-3 flex flex-wrap items-center gap-2">
						{teamProfile.roles.map((share, index) => (
							<span data-tip-title={roleLabel(share.role)} data-tip={`${pluralize(share.games, 'partie')} à cinq`}
								class:list={['inline-flex h-8 items-center gap-2 border px-2.5 text-xs',
									index === 0 ? 'border-gold-300/50 bg-gold-200/8 text-gold-100' : 'border-white/10 text-muted']}>
								<RoleIcon role={share.role} decorative class="size-4" />
								{index === 0 ? roleLabel(share.role) : share.games}
								<span class="sr-only">{roleLabel(share.role)} : {share.games} parties</span>
							</span>
						))}
					</p>
				)}
			</div>
			<div class="flex gap-4 sm:justify-end">
				{queues.map(({ label, activity }) => (
					<div class="flex items-center gap-2">
						<RankEmblem queue={label} rank={activity.currentRank} size="md" />
						<div class="text-xs leading-tight">
							<p class="label-caps text-[0.6rem] text-muted">{label}</p>
							<p class="mt-1 text-sm text-ink">{activity.currentRank?.tier ? tierLabel(activity.currentRank.tier, activity.currentRank.division) : '—'}</p>
							{activity.currentRank?.tier && activity.currentRank.leaguePoints !== null && (
								<p class="tabular-nums text-muted">{activity.currentRank.leaguePoints} LP</p>
							)}
						</div>
					</div>
				))}
			</div>
		</header>

		<div class="grid items-start gap-10 lg:grid-cols-[minmax(0,1.6fr)_minmax(18rem,1fr)] lg:gap-12">
			<section aria-labelledby="team-heading" class="min-w-0">
				<p class="label-caps text-gold-200">Avec les Étoiles</p>
				<h2 id="team-heading" class="mt-2 font-display text-3xl text-ink">{pluralize(teamGames, 'partie')} à cinq</h2>

				{teamProfile && teamGames > 0 ? (
					<>
						<dl class="mt-5 grid grid-cols-2 gap-px border border-white/10 bg-white/10 sm:grid-cols-4">
							<div class="bg-night-900/90 p-4">
								<dt class="label-caps text-muted">Bilan</dt>
								<dd class="mt-2">
									<span class="font-display text-2xl tabular-nums text-ink">{teamWins}<span class="text-grey-700"> – </span>{teamGames - teamWins}</span>
									<MeterBar ratio={teamWins / teamGames} tone="win" class="mt-2 h-1" />
									<span class="mt-1 block text-xs tabular-nums text-muted">{formatPercent(teamWins / teamGames)} de victoires</span>
								</dd>
							</div>
							<div class="bg-night-900/90 p-4" data-tip={teamProfile.averageKills === null ? undefined : `Moyenne : ${formatDecimal(teamProfile.averageKills)} / ${formatDecimal(teamProfile.averageDeaths ?? 0)} / ${formatDecimal(teamProfile.averageAssists ?? 0)}`}>
								<dt class="label-caps text-muted">KDA</dt>
								<dd class="mt-2 font-display text-2xl tabular-nums text-ink">{teamProfile.kda === null ? '—' : formatDecimal(teamProfile.kda)}</dd>
							</div>
							<div class="bg-night-900/90 p-4" data-tip="Part des éliminations de l’équipe auxquelles il participe">
								<dt class="label-caps text-muted">Participation</dt>
								<dd class="mt-2 font-display text-2xl tabular-nums text-ink">
									{teamProfile.killParticipation === null ? '—' : formatPercent(teamProfile.killParticipation)}
								</dd>
							</div>
							<div class="bg-night-900/90 p-4">
								<dt class="label-caps text-muted">{mainStat.label}</dt>
								<dd class="mt-2 font-display text-2xl tabular-nums text-ink">{mainStat.value === null ? '—' : formatDecimal(mainStat.value)}</dd>
							</div>
						</dl>

						<div id="pool" class="mt-8 flex scroll-mt-28 flex-wrap items-center justify-between gap-3">
							<h3 class="font-display text-xl text-ink">
								Pool à cinq <span class="font-body text-sm text-muted">· {pluralize(teamChampions.length, 'champion')}</span>
							</h3>
							<SegmentedNav label="Trier le pool à cinq" options={championSorts.map((sort) => ({
								href: link('champions', sort.value, 'pool'),
								label: sort.label,
								active: sort.value === championSort,
							}))} />
						</div>
						<ul class="mt-4 grid gap-x-6 gap-y-4 sm:grid-cols-2 xl:grid-cols-3">
							{teamChampions.map((record, index) => (
								<MotionItem as="li" index={index}>
									<ChampionTile variant="row" champion={record.champion} games={record.games} wins={record.wins}
										lastPlayedAt={record.lastPlayedAt} kda={record.kda} context="À cinq" />
								</MotionItem>
							))}
						</ul>

						{teamProfile.bestGame && (
							<a href={`/matches/${teamProfile.bestGame.matchId}`}
								class="focus-ring group mt-8 flex items-center gap-4 border border-gold-300/30 bg-linear-to-r from-gold-200/8 to-transparent p-3 transition-colors hover:border-gold-200/70">
								<ChampionIcon champion={teamProfile.bestGame.champion} size="lg" outcome={teamProfile.bestGame.outcome} tip={false} />
								<span class="min-w-0 flex-1">
									<span class="label-caps block text-gold-200">Sa plus belle ligne à cinq</span>
									<span class="mt-1 block font-display text-xl tabular-nums text-ink">
										{formatKda(teamProfile.bestGame.kills, teamProfile.bestGame.deaths, teamProfile.bestGame.assists)}
									</span>
									<span class="text-xs text-muted">{championName(teamProfile.bestGame.champion)} · {formatShortDate(teamProfile.bestGame.startedAt)}</span>
								</span>
								<OpggIcon name="ui-arrow-right" class="size-3 text-gold-200 transition-transform group-hover:translate-x-1" />
							</a>
						)}
						{moments.length > 0 && (
							<div class="mt-8">
								<h3 class="mb-4 font-display text-xl text-ink">Ses éclats à cinq</h3>
								<MomentList moments={moments.slice(0, 4)} label="Multikills du joueur à cinq" />
								{moments.length > 4 && <details class="mt-3">
									<summary class="focus-ring w-fit cursor-pointer text-xs text-hextech-300">{moments.length - 4} autres éclats</summary>
									<div class="mt-3"><MomentList moments={moments.slice(4)} label="Autres multikills à cinq" /></div>
								</details>}
							</div>
						)}
					</>
				) : (
					<Panel class="mt-5 p-5 sm:p-7">
						<p class="text-sm text-muted">Pas encore de partie complète à cinq.</p>
					</Panel>
				)}
			</section>

			<aside aria-labelledby="ranked-heading" class="min-w-0 lg:sticky lg:top-24">
				<p class="label-caps text-hextech-300">En solo & en flex</p>
				<h2 id="ranked-heading" class="mt-2 font-display text-3xl text-ink">Parcours classé</h2>
				<div class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-1">
					{queues.map(({ key, label, activity }) => (
						<Panel as="article" class="p-4">
							<div class="flex items-center gap-3">
								<RankEmblem queue={label} rank={activity.currentRank} size="md" />
								<div class="min-w-0 flex-1">
									<h3 class="flex items-center gap-2"><QueueBadge queue={key} /><span class="sr-only">{label}</span></h3>
									<p class="mt-1 text-sm tabular-nums text-ink">
										{activity.games > 0 ? <>{activity.wins} V <span class="text-grey-700">–</span> {activity.games - activity.wins} D</> : 'Aucune partie enregistrée'}
									</p>
									{activity.games > 0 && (
										<p class="text-xs text-muted">{activity.lastPlayedAt && `Dernière ${formatSince(activity.lastPlayedAt)}`}</p>
									)}
								</div>
								{activity.winRate !== null && activity.games >= MIN_DRAFT_GAMES && (
									<span class="font-display text-xl tabular-nums text-gold-100">{formatPercent(activity.winRate)}</span>
								)}
							</div>
							{activity.games > 0 && <MeterBar ratio={activity.wins / activity.games} tone="win" class="mt-3 h-1" />}
							{activity.champions.length > 0 && (
								<ul class="mt-4 flex flex-wrap gap-x-3 gap-y-3" aria-label={`Champions les plus joués en ${label}`}>
									{activity.champions.slice(0, 6).map((record) => (
										<li>
											<ChampionTile champion={record.champion} games={record.games} wins={record.wins}
												lastPlayedAt={record.lastPlayedAt} size="sm" context={label} />
										</li>
									))}
								</ul>
							)}
							<RankProgress history={activity.rankHistory} queue={label} />
						</Panel>
					))}
				</div>
				<Discoveries discoveries={discoveries} />
			</aside>
		</div>

		<section id="recent" aria-labelledby="recent-heading" class="scroll-mt-24">
			<div class="flex flex-wrap items-end justify-between gap-3">
				<h2 id="recent-heading" class="font-display text-3xl text-ink">Dernières parties</h2>
				<SegmentedNav label="Filtrer les parties" options={matchFilters.map((filter) => ({
					href: link('parties', filter.value, 'recent'),
					label: `${filter.label} · ${allRecent.filter(filter.test).length}`,
					active: filter.value === matchFilter.value,
				}))} />
			</div>
			{recentMatches.length === 0 ? (
				<p class="mt-5 border-l border-white/15 py-3 pl-5 text-sm text-muted">Aucune partie classée dans cette sélection.</p>
			) : (
				<ol class="mt-5 divide-y divide-white/8 border-y border-white/10">
					{recentMatches.map((match, index) => (
						<MotionItem as="li" index={index} delayStep={25}>
							<a href={`/matches/${match.id}`}
								class="focus-ring group relative grid grid-cols-[auto_minmax(0,1fr)_auto] items-center gap-x-4 gap-y-2 py-3 pr-3 pl-5 transition-colors hover:bg-white/5 md:grid-cols-[auto_minmax(0,1fr)_4rem_6.5rem_7rem_6.5rem]">
								<span aria-hidden="true" class:list={['absolute inset-y-2 left-0 w-1', match.outcome === 'win' ? 'bg-win shadow-glow-gold' : 'bg-loss']}></span>
								<span class="relative">
									<ChampionIcon champion={match.champion} size="md" outcome={match.outcome} tip={false} />
									<RoleIcon role={match.role} decorative class="absolute -right-1.5 -bottom-1.5 size-4 rounded-full bg-night-950 p-px" />
								</span>
								<span class="min-w-0">
									<span class:list={['block font-display text-base', match.outcome === 'win' ? 'text-gold-100' : 'text-grey-300']}>
										{match.outcome === 'win' ? 'Victoire' : 'Défaite'}
										<span class="font-body text-sm text-muted"> · {championName(match.champion)}</span>
									</span>
									<span class="block text-xs text-muted">
										<span class="sr-only">{roleLabel(match.role)}, </span>
										<time datetime={new Date(match.startedAt).toISOString()}>{formatShortDate(match.startedAt)}</time> · patch {match.patch}
									</span>
								</span>
								<QueueBadge queue={match.queue} class="justify-self-end md:justify-self-start" />
								<StarPresence count={match.teamSize} tip={presenceTip(match)} class="col-start-2 md:col-auto" />
								<span class="col-start-3 row-start-2 text-right text-sm tabular-nums text-ink md:col-auto md:row-auto md:text-left">
									{formatKda(match.kills, match.deaths, match.assists)}
								</span>
								<span class="hidden text-right text-xs text-muted md:block">{formatSince(match.startedAt)}</span>
							</a>
						</MotionItem>
					))}
				</ol>
			)}
		</section>
	</main>
</BaseLayout>
