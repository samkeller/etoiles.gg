---
import OpggIcon from '../../components/ui/OpggIcon.astro';
import MatchDetail from '../../components/matches/MatchDetail.astro';
import Panel from '../../components/ui/Panel.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { db } from '../../lib/db/db';
import { formatDate } from '../../lib/format';
import { getMatchDetail } from '../../lib/stats';

export const prerender = false;

const id = Astro.params.id ?? '';
const match = getMatchDetail(db, id);
if (!match) return new Response('Match introuvable.', { status: 404 });
const result = match.outcome === 'win' ? 'Victoire' : 'Défaite';
---

<BaseLayout title={`${result} · ${formatDate(match.startedAt)} — etoiles.win`} description={`Le récit de notre match du ${formatDate(match.startedAt)} : composition, statistiques, objectifs et patch ${match.patch}.`}>
	<main class="mx-auto flex w-full max-w-7xl flex-1 flex-col gap-8 px-4 py-10 sm:px-8 sm:py-14">
		<nav aria-label="Fil d’Ariane">
			<a href="/history" class="focus-ring inline-flex items-center gap-2 text-sm text-muted transition-colors hover:text-ink">
				<OpggIcon name="ui-arrow-right" class="size-3 rotate-180" /> Retour à la mémoire des Étoiles
			</a>
		</nav>
		<header class="max-w-3xl">
			<p class="label-caps text-sky-300">{match.queueId === 420 ? 'Solo/Duo classée' : 'Classé flexible'} · patch {match.patch}</p>
			<h1 class="mt-3 font-display text-4xl text-ink sm:text-5xl">{result} · {formatDate(match.startedAt)}</h1>
			<p class="mt-4 text-sm leading-relaxed text-muted">
				Une partie de l’histoire des Étoiles. Les statistiques collectives ne retiennent ce match que si les cinq joueurs étaient réunis en Flex.
			</p>
		</header>
		<Panel class="p-4 sm:p-8">
			<MatchDetail detail={match} titleId="match-result" />
		</Panel>
	</main>
</BaseLayout>
import OpggIcon from '../../components/ui/OpggIcon.astro';
