---
import OpggIcon from '../../components/ui/OpggIcon.astro';
import MatchDetail from '../../components/matches/MatchDetail.astro';
import Panel from '../../components/ui/Panel.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { db } from '../../lib/db/db';
import { formatDate } from '../../lib/format';
import { SITE_NAME } from '../../lib/site';
import { getMatchDetail, getMatchMoments, getMatchTimeline } from '../../lib/stats';

export const prerender = false;

const id = Astro.params.id ?? '';
const match = getMatchDetail(db, id);
if (!match) return new Response('Match introuvable.', { status: 404 });
const result = match.isCollision ? 'Collision stellaire' : match.outcome === 'win' ? 'Victoire' : 'Défaite';
const fullTeam = !match.isCollision && match.queueId === 440 && match.lineupSize === 5;
---

<BaseLayout title={`${result} · ${formatDate(match.startedAt)} — ${SITE_NAME}`} description={`Le récit de notre match du ${formatDate(match.startedAt)} : composition, statistiques, objectifs et patch ${match.patch}.`}>
	<main class="mx-auto flex w-full max-w-7xl flex-1 flex-col gap-8 px-4 py-10 sm:px-8 sm:py-14">
		<nav aria-label="Fil d’Ariane">
			<a href="/history" data-navigate-back class="focus-ring inline-flex items-center gap-2 text-sm text-muted transition-colors hover:text-ink">
				<OpggIcon name="ui-arrow-right" class="size-3 rotate-180" /> <span data-back-label>Retour à la mémoire des Étoiles</span>
			</a>
		</nav>
		<header class="max-w-3xl">
			<p class="label-caps text-gold-200">{match.isCollision ? 'Collision stellaire' : match.queueId === 420 ? 'Solo/Duo classée' : 'Classé flexible'} · patch {match.patch}</p>
			<h1 class="mt-2 font-display text-4xl font-medium tracking-tight text-ink sm:text-5xl">{result} · {formatDate(match.startedAt)}</h1>
		</header>
		<Panel class="p-4 sm:p-8">
			<MatchDetail detail={match} titleId="match-result" moments={fullTeam ? getMatchMoments(db, id) : []} timeline={fullTeam ? getMatchTimeline(db, id) : undefined} />
		</Panel>
	</main>
</BaseLayout>

<script>
	import { getBackHref, navigateBack } from '../../lib/navigation';

	const back = document.querySelector<HTMLAnchorElement>('[data-navigate-back]');
	if (back) {
		back.href = getBackHref(document.referrer, window.location.href);
		const label = back.querySelector('[data-back-label]');
		if (label && new URL(back.href).pathname !== '/history') label.textContent = 'Retour à la page précédente';
		back.addEventListener('click', (event) => {
			if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
			event.preventDefault();
			navigateBack();
		});
	}
</script>
