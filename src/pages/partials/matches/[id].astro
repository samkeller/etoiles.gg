---
import MatchDetail from '../../../components/matches/MatchDetail.astro';
import { db } from '../../../lib/db/db';
import { getMatchDetail, getMatchMoments, getMatchTimeline } from '../../../lib/stats';

/** Fragment HTML chargé dans le dialog de l'historique. */
export const partial = true;

const detail = getMatchDetail(db, Astro.params.id ?? '');
if (detail === null) return new Response(null, { status: 404 });
const fullTeam = detail.queueId === 440 && detail.lineupSize === 5;
---

<MatchDetail detail={detail} titleId="match-dialog-title" moments={fullTeam ? getMatchMoments(db, detail.id) : []} timeline={fullTeam ? getMatchTimeline(db, detail.id) : undefined} />
