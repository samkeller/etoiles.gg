---
import BaseLayout from '../layouts/BaseLayout.astro';
import DraftApp from '../components/draft/DraftApp';
import { sidebarRecords } from '../components/draft/sidebarRecords';
import { db } from '../lib/db/db';
import { SITE_NAME } from '../lib/site';
import { compareRoles } from '../lib/lol';
import championNames from '../lib/lol/champion-names.json';
import {
	explorationPicks,
	getDraftHistory,
	getDraftOpponents,
	getIndividualProfiles,
	getPlayers,
	getTeamBans,
	MIN_DRAFT_GAMES,
} from '../lib/stats';

const EXPLORATION_LIMIT = 6;

const individual = new Map(getIndividualProfiles(db).map((profile) => [profile.puuid, profile]));
const seats = getPlayers(db)
	.sort((left, right) => compareRoles(left.mainRole, right.mainRole) || left.name.localeCompare(right.name, 'fr'))
	.map((player) => {
		const personal = individual.get(player.puuid);
		return {
			puuid: player.puuid,
			name: player.name,
			role: player.mainRole,
			pool: player.champions,
			explore: personal
				? explorationPicks(player.champions, [personal.soloDuo.champions, personal.flex.champions], EXPLORATION_LIMIT)
				: [],
		};
	});

const { matches, compositions } = getDraftHistory(db);
const bans = getTeamBans(db);
const opponents = getDraftOpponents(db);
const catalog = Object.entries(championNames)
	.map(([id, name]) => ({ id, name }))
	.sort((left, right) => left.name.localeCompare(right.name, 'fr'));
const renderedAt = Date.now();
const normalize = (value: string) => value.normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/[^a-z0-9]/gi, '').toLowerCase();
const championLookup = new Map(catalog.flatMap(({ id, name }) => [[normalize(name), id], [normalize(id), id]]));
const queryPicks = Astro.url.searchParams.get('picks')?.split(',') ?? [];
const initialPicks = seats.map((_, index) => {
	const value = queryPicks[index];
	return value ? championLookup.get(normalize(value)) ?? null : null;
});
const { banRecords, opponentRecords } = sidebarRecords(bans.records, opponents);
const draftSeats = seats.map(({ puuid, name, role, pool, explore }) => ({
	puuid,
	name,
	role,
	pool: pool.map(({ champion, games, wins }) => ({ champion, games, wins })),
	explore: explore.map(({ champion, games, wins }) => ({ champion, games, wins })),
}));
const draftCompositions = compositions.map(({ champions, games, wins, lastPlayedAt, matchIds }) => ({
	champions,
	games,
	wins,
	lastPlayedAt,
	latestMatchId: matchIds[0],
}));
const draftAppData = {
	seats: draftSeats,
	matches,
	compositions: draftCompositions,
	champions: catalog,
	minimumGames: MIN_DRAFT_GAMES,
	initialPicks,
	banRecords,
	opponentRecords,
	renderedAt,
};
---

<BaseLayout title={`Draft — ${SITE_NAME}`} description="Préparer une composition à partir des champions réellement joués à cinq par les Étoiles.">
	<main class="mx-auto flex w-full max-w-7xl flex-1 flex-col gap-10 px-4 py-10 sm:px-8 sm:py-14">
		<DraftApp client:load {...draftAppData} />
	</main>
</BaseLayout>
