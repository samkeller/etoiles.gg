---
import MatchHistory from '../components/sections/MatchHistory.astro';
import TeamOverview from '../components/sections/TeamOverview.astro';
import TeamRoster from '../components/sections/TeamRoster.astro';
import TeamCollective from '../components/sections/TeamCollective.astro';
import SessionConstellation from '../components/memory/SessionConstellation.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { db } from '../lib/db/db';
import { calculateCollective, getMatches, getOverview, getPlayers, getTeamSessions } from '../lib/stats';
import { isPosition } from '../lib/lol';
import type { Position } from '../lib/types';
import { TEAM_NAME } from '../lib/site';

const associationRoles: Position[] = [];
for (const key of ['role', 'role2']) {
	const value = Astro.url.searchParams.get(key);
	if (!value) continue;
	if (!isPosition(value)) return new Response('Rôle invalide : attendu TOP, JUNGLE, MIDDLE, BOTTOM ou UTILITY.', { status: 400 });
	if (!associationRoles.includes(value)) associationRoles.push(value);
}

const overview = getOverview(db);
const players = getPlayers(db);
const fullMatches = getMatches(db, 'full');
const partialMatches = getMatches(db, 'partial');
const sessions = getTeamSessions(fullMatches);
const collective = calculateCollective(fullMatches, associationRoles);
const recentMatches = fullMatches.slice(0, overview.recentForm.length).reverse();
---

<BaseLayout title={`${TEAM_NAME} — le carnet de bord`} description="Les parties, les soirées et les idées des Étoiles de l’Esport. Fait à cinq, pour les cinq.">
	<main class="flex w-full flex-1 flex-col gap-16 pb-16 sm:gap-24">
		<TeamOverview overview={overview} recentMatches={recentMatches} latestSession={sessions[0] ?? null} />
		<div class="mx-auto flex w-full max-w-7xl flex-col gap-16 px-4 sm:gap-24 sm:px-8">
			<SessionConstellation sessions={sessions} compact />
			<TeamRoster players={players} />
			<MatchHistory fullMatches={fullMatches} partialMatches={partialMatches} />
			<TeamCollective collective={collective} associationRoles={associationRoles} />
		</div>
	</main>
</BaseLayout>
