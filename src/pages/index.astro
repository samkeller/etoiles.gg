---
import MatchHistory from '../components/sections/MatchHistory.astro';
import TeamOverview from '../components/sections/TeamOverview.astro';
import TeamRoster from '../components/sections/TeamRoster.astro';
import TeamCollective from '../components/sections/TeamCollective.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { db } from '../lib/db/db';
import { getCollective, getMatches, getOverview, getPlayers } from '../lib/stats';
import { isPosition } from '../lib/lol';
import type { Position } from '../lib/types';

const associationRoles: Position[] = [];
for (const key of ['role', 'role2']) {
	const value = Astro.url.searchParams.get(key);
	if (!value) continue;
	if (!isPosition(value)) return new Response('Rôle invalide : attendu TOP, JUNGLE, MIDDLE, BOTTOM ou UTILITY.', { status: 400 });
	if (!associationRoles.includes(value)) associationRoles.push(value);
}

const overview = getOverview(db);
const players = getPlayers(db);
const fullMatches = getMatches(db, 'full');
const partialMatches = getMatches(db, 'partial');
const collective = getCollective(db, associationRoles);
const navigation = [
	{ href: '#team-title', label: 'Équipe' },
	{ href: '#history-title', label: 'Historique' },
	{ href: '#roster-title', label: 'Joueurs' },
	{ href: '#collective-title', label: 'Collectif' },
];
---

<BaseLayout>
	<div class="mx-auto flex min-h-dvh w-full max-w-7xl flex-col px-4 sm:px-8">
		<header class="flex flex-wrap items-center justify-between gap-6 border-b border-gold-700/60 py-5">
			<a href="/" class="focus-ring flex items-center gap-3" aria-label="etoiles.gg, accueil">
				<img src="/logo_clean.png" alt="" width="32" height="32" class="size-7" />
				<span class="font-display text-xl font-bold tracking-wide text-ink">
					etoiles<span class="text-gold-200">.gg</span>
				</span>
			</a>
			<nav aria-label="Sections">
				<ul class="flex gap-5">
					{
						navigation.map((item) => (
							<li>
								<a href={item.href} class="focus-ring label-caps text-muted transition-colors hover:text-gold-100">
									{item.label}
								</a>
							</li>
						))
					}
				</ul>
			</nav>
		</header>

		<main class="flex flex-1 flex-col gap-20 py-14 sm:py-20">
			<TeamOverview overview={overview} />
			<MatchHistory fullMatches={fullMatches} partialMatches={partialMatches} />
			<TeamRoster players={players} />
			<TeamCollective collective={collective} associationRoles={associationRoles} />
		</main>

		<footer class="border-t border-gold-700/60 py-5 text-xs leading-relaxed text-muted">
			etoiles.gg n'est pas approuvé par Riot Games et ne reflète pas les opinions de Riot Games ni
			de quiconque officiellement impliqué dans la production ou la gestion des propriétés de Riot
			Games. Riot Games et toutes les propriétés associées sont des marques commerciales ou des
			marques déposées de Riot Games, Inc.
		</footer>
	</div>
</BaseLayout>
