---
import DraftRow from './DraftRow.astro';
import Disclosure from '../ui/Disclosure.astro';
import Panel from '../ui/Panel.astro';
import { pluralize } from '../../lib/format';
import { ROLE_ORDER, roleLabel } from '../../lib/lol';
import type { DraftObservation, PendingDraftObservation } from '../../lib/stats';
import type { Position } from '../../lib/types';
import RoleIcon from '../ui/RoleIcon.astro';

interface Props {
	title: string;
	id: string;
	observations: readonly DraftObservation[];
	pending: readonly PendingDraftObservation[];
	baseline: number;
	minimumGames: number;
	composition?: boolean;
	associationRoles?: readonly Position[];
}

const { title, id, observations, pending, baseline, minimumGames, composition = false, associationRoles = [] } = Astro.props;
const visible = observations.slice(0, 4);
const remaining = observations.slice(4);

/** Un clic ajoute le rôle (deux au plus, le second est remplacé) ou le retire du filtre. */
function roleHref(role: Position): string {
	const next = associationRoles.includes(role)
		? associationRoles.filter((current) => current !== role)
		: [...associationRoles.slice(0, 1), role];
	const params = new URLSearchParams();
	next.forEach((value, index) => params.set(index === 0 ? 'role' : 'role2', value));
	const query = params.toString();
	return `/analysis${query ? `?${query}` : ''}#collective-title`;
}
---

<Panel as="div" aria-labelledby={id}>
	<header class="border-b border-gold-700/50 px-5 py-5 sm:px-7">
		<h3 {id} class="font-display text-xl font-bold text-ink">{title}</h3>
		<p class="mt-1 text-xs text-muted">
			{composition ? 'Même joueur, même champion, même rôle.' : 'Chaque champion est associé au joueur qui le joue.'}
		</p>
	</header>
	{!composition && (
		<nav aria-label="Filtrer les synergies par rôles" class="flex flex-wrap items-center gap-3 border-b border-gold-700/40 px-5 py-4 sm:px-7">
			<span class="label-caps text-[0.65rem] text-muted">Rôles</span>
			<ul class="flex gap-1">
				{ROLE_ORDER.map((role) => {
					const active = associationRoles.includes(role);
					return (
						<li>
							<a href={roleHref(role)} aria-current={active ? 'true' : undefined}
								data-tip-title={roleLabel(role)}
								data-tip={active ? 'Retirer du filtre' : associationRoles.length >= 2 ? 'Remplace le second rôle' : 'Ajouter au filtre'}
								class:list={['focus-ring grid size-10 place-items-center border transition-colors motion-reduce:transition-none',
									active ? 'border-gold-200/70 bg-gold-200/12 shadow-glow-gold' : 'border-white/10 hover:border-white/30 hover:bg-white/5']}>
								<RoleIcon role={role} decorative class={active ? 'size-6' : 'size-6 opacity-60'} />
							</a>
						</li>
					);
				})}
			</ul>
			{associationRoles.length > 0 && (
				<a href="/analysis#collective-title" class="focus-ring text-xs text-muted underline underline-offset-4 hover:text-ink">Tous les rôles</a>
			)}
		</nav>
	)}
	<p class="sr-only" role="status">{pluralize(observations.length, 'observation')} correspondant aux critères.</p>
	{observations.length === 0 ? (
		<p class="px-5 py-10 text-sm leading-relaxed text-muted sm:px-7">
			{composition ? 'Aucune composition complète' : 'Aucune association'} n'a encore atteint les {minimumGames} matchs à cinq{associationRoles.length > 0 ? ' pour les rôles sélectionnés' : ''}.
		</p>
	) : (
		<>
			<ul class="divide-y divide-gold-700/40">
				{visible.map((observation) => (
					<li><DraftRow {observation} {baseline} {composition} /></li>
				))}
			</ul>
			{remaining.length > 0 && (
				<Disclosure
					summary={`Voir les ${pluralize(remaining.length, 'autre observation', 'autres observations')}`}
					class="border-t border-gold-700/40"
				>
					<ul class="divide-y divide-gold-700/40 border-t border-gold-700/40">
						{remaining.map((observation) => (
							<li><DraftRow {observation} {baseline} {composition} /></li>
						))}
					</ul>
				</Disclosure>
			)}
			{pending.length > 0 && (
				<Disclosure summary={`Encore un match · ${pluralize(pending.length, 'association à confirmer', 'associations à confirmer')}`}
					class="border-t border-hextech-300/30">
					<ul class="divide-y divide-gold-700/40">
						{pending.map((observation) => (
							<li><DraftRow {observation} {baseline} {composition} minimumGames={minimumGames} /></li>
						))}
					</ul>
				</Disclosure>
			)}
		</>
	)}
</Panel>
