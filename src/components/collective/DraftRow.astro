---
import ChampionIcon from '../ui/ChampionIcon.astro';
import RoleIcon from '../ui/RoleIcon.astro';
import WinRateComparison from '../ui/WinRateComparison.astro';
import { championName } from '../../lib/lol';
import { pluralize } from '../../lib/format';
import type { DraftObservation, PendingDraftObservation } from '../../lib/stats';

interface Props {
	observation: DraftObservation | PendingDraftObservation;
	baseline: number;
	composition?: boolean;
	minimumGames?: number;
}

const { observation, baseline, composition = false, minimumGames = 5 } = Astro.props;
---

<article class="px-5 py-5 sm:px-7">
	<div class="flex flex-col gap-5 sm:flex-row sm:items-center sm:justify-between">
		<ul class:list={['grid min-w-0 flex-1 gap-x-5 gap-y-3', composition ? 'grid-cols-2 lg:grid-cols-5' : 'sm:grid-cols-2']}>
			{observation.members.map((member) => (
				<li class="flex min-w-0 items-center gap-3">
					<ChampionIcon champion={member.champion} />
					<div class="min-w-0">
						<p class="flex items-center gap-1.5 font-display font-bold text-ink">
							{composition && <RoleIcon role={member.role} class="size-3" />}
							<span class="truncate" title={championName(member.champion)}>{championName(member.champion)}</span>
						</p>
						<p class="truncate text-xs text-muted" title={member.name}>{member.name}</p>
					</div>
				</li>
			))}
		</ul>
		{'winRate' in observation ? (
			<WinRateComparison winRate={observation.winRate} baseline={baseline} games={observation.games} wins={observation.wins} />
		) : (
			<p class="text-sm text-hextech-300">{observation.games}/{minimumGames} matchs · encore {minimumGames - observation.games} match pour un bilan</p>
		)}
	</div>
	<div class="mt-4 flex items-center justify-between gap-3 text-xs text-muted">
		<span>{pluralize(observation.games, 'match ensemble', 'matchs ensemble')}</span>
		<button
			type="button"
			data-match-id={observation.latestMatchId}
			aria-haspopup="dialog"
			aria-label={`Ouvrir le dernier match de ${observation.members.map((member) => `${member.name} sur ${championName(member.champion)}`).join(' et ')}`}
			class="focus-ring text-hextech-300 underline decoration-hextech-300/30 underline-offset-4 hover:decoration-hextech-300"
		>
			Dernier match <span aria-hidden="true">↗</span>
		</button>
	</div>
</article>
