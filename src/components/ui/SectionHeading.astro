---
interface Props {
	eyebrow: string;
	title: string;
	id: string;
}

const { eyebrow, title, id } = Astro.props;
---

<header class="mb-8 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
	<div>
		<p class="label-caps flex items-center gap-2 text-gold-200">
			<span class="size-1.5 rotate-45 bg-gold-200" aria-hidden="true"></span>
			{eyebrow}
		</p>
		<h2 {id} class="mt-2 font-display text-3xl font-bold uppercase tracking-wide text-gold-gradient">{title}</h2>
	</div>
	<slot />
</header>
