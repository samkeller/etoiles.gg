---
interface Props {
	label: string;
	value: string;
	/** Chemin d'une icône de /public, purement décorative. */
	icon?: string;
}

const { label, value, icon } = Astro.props;
---

<div class="flex items-center gap-3">
	{
		icon && (
			<span class="grid size-10 shrink-0 rotate-45 place-items-center border border-gold-500/60 bg-night-950/60">
				<img src={icon} alt="" width="20" height="20" class="size-5 -rotate-45 object-contain" />
			</span>
		)
	}
	<div class="flex min-w-0 flex-col">
		<dt class="label-caps text-muted">{label}</dt>
		<dd class="font-display text-2xl font-bold tabular-nums text-ink">{value}</dd>
	</div>
</div>
