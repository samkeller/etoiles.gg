---
interface Props {
	label: string;
	value: string;
	/** Chemin d'une icône de /public, purement décorative. */
	icon?: string;
	size?: 'sm' | 'md';
	/** Précision secondaire sous la valeur. */
	hint?: string;
}

const { label, value, icon, size = 'md', hint } = Astro.props;
---

<div class="flex items-center gap-3">
	{
		icon && (
			<span class="grid size-10 shrink-0 rotate-45 place-items-center border border-gold-500/60 bg-night-950/60">
				<img src={icon} alt="" width="20" height="20" class="size-5 -rotate-45 object-contain" />
			</span>
		)
	}
	<div class="flex min-w-0 flex-col">
		<dt class="label-caps text-muted">{label}</dt>
		<dd class:list={['font-display font-bold tabular-nums text-ink', size === 'md' ? 'text-2xl' : 'text-lg leading-tight']}>
			{value}
		</dd>
		{hint && <dd class="text-xs text-muted">{hint}</dd>}
	</div>
</div>
