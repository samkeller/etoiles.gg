---
import MeterBar from './MeterBar.astro';
import { formatPercent } from '../../lib/format';

interface Props {
	winRate: number;
	baseline: number;
	games: number;
	wins: number;
}

const { winRate, baseline, games, wins } = Astro.props;
---

<div class="w-full sm:w-44">
	<div class="mb-2 flex items-baseline justify-between gap-3">
		<span class:list={['font-display text-2xl font-bold tabular-nums', winRate > baseline ? 'text-win' : 'text-ink']}>
			{formatPercent(winRate)}
		</span>
		<span class="text-xs tabular-nums text-muted">{wins} V / {games - wins} D</span>
	</div>
	<div class="relative" title={`Repère : bilan global à cinq (${formatPercent(baseline)})`}>
		<MeterBar ratio={winRate} tone={winRate > baseline ? 'win' : 'neutral'} class="h-2" />
		<span aria-hidden="true" class="absolute -top-1 h-4 w-px bg-ink" style={`left: ${baseline * 100}%`}></span>
	</div>
	<span class="sr-only">Bilan global à cinq : {formatPercent(baseline)}. {games} matchs observés.</span>
</div>
