---
import type { MatchSummary } from '../../lib/stats';
import { formatDate, formatTime } from '../../lib/format';
import MotionItem from './MotionItem.astro';
import OpggIcon from './OpggIcon.astro';

interface Props {
	/** Résultats du plus ancien au plus récent. */
	matches: readonly MatchSummary[];
	/** Nombre de résultats finaux appartenant à la série en cours. */
	streakCount?: number;
	class?: string;
}

const { matches, streakCount = 0, class: className } = Astro.props;
const streakStart = matches.length - streakCount;
---

<ol class:list={['grid grid-cols-10 gap-x-2 gap-y-4 sm:grid-cols-20', className]}>
	{
		matches.map((match, index) => {
			const isWin = match.outcome === 'win';
			const inStreak = index >= streakStart;
			return (
				<MotionItem as="li" index={index} class="flex justify-center">
					<button type="button" data-match-id={match.id} aria-haspopup="dialog"
						aria-label={`${isWin ? 'Victoire' : 'Défaite'} du ${formatDate(match.startedAt)} à ${formatTime(match.startedAt)} : ouvrir le match`}
						class:list={[
							'focus-ring grid size-7 rotate-45 place-items-center border transition-transform hover:scale-110',
							isWin ? 'border-gold-300 bg-gold-700/70' : 'border-grey-700 bg-night-800/90',
							inStreak && isWin && 'border-gold-100 shadow-glow-gold',
							inStreak && !isWin && 'border-grey-300/60',
						]}
					>
						<OpggIcon
							name={isWin ? 'ui-check' : 'ui-close'}
							class={`size-3.5 -rotate-45 ${isWin ? 'text-gold-100' : 'text-grey-300 opacity-80'}`}
						/>
					</button>
				</MotionItem>
			);
		})
	}
</ol>
