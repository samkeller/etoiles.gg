---
import OpggIcon from './OpggIcon.astro';

interface Props {
	/** Nombre d'Étoiles présentes dans la partie (1 à 5). */
	count: number;
	/** Précision ajoutée dans la bulle. */
	tip?: string;
	size?: 'sm' | 'md';
	class?: string;
}

const { count, tip, size = 'sm', class: className } = Astro.props;
const present = Math.max(0, Math.min(5, Math.round(count)));
const label = present >= 5 ? 'Les cinq Étoiles' : present <= 1 ? 'Sans les autres Étoiles' : `${present} Étoiles sur 5`;
---

<span role="img" aria-label={label} data-tip-title={label} data-tip={tip}
	class:list={['inline-flex shrink-0 items-center', size === 'sm' ? 'gap-0.5' : 'gap-1', className]}>
	{Array.from({ length: 5 }, (_, index) => (
		<OpggIcon
			name="star"
			class={`${size === 'sm' ? 'size-3' : 'size-4'} ${index < present ? 'text-gold-200' : 'text-grey-700'} ${index < present && present >= 5 ? 'drop-shadow-[0_0_3px_rgb(215_193_139/0.7)]' : ''}`}
		/>
	))}
</span>
