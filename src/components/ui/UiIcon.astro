---
import type { OpggIconName } from '../../lib/opgg-icons';
import OpggIcon from './OpggIcon.astro';

const icons = {
	kills: 'stat-kills',
	gold: 'stat-gold',
	vision: 'stat-vision',
	towers: 'objective-tower',
	inhibitors: 'objective-inhibitor',
	dragons: 'objective-dragon',
	heralds: 'objective-riftherald',
	barons: 'objective-baronnashor',
	voidgrubs: 'objective-voidgrub',
	creepScore: 'stat-creep-score',
	damage: 'stat-damage',
} as const;

interface Props {
	key: keyof typeof icons;
	size: 'sm' | 'md' | 'lg';
}

const { key, size } = Astro.props;
const icon = icons[key] satisfies OpggIconName;
---

<OpggIcon name={icon} class={`${size === 'sm' ? 'size-3' : size === 'md' ? 'size-4' : 'size-5'} opacity-70`} />
