---
const icons = {
	kills: '/riot/ui/kills.png',
	gold: '/riot/ui/icon_gold.png',
	vision: '/riot/ui/ward.png',
	towers: '/riot/ui/tower_building_blue.png',
	inhibitors: '/riot/ui/inhibitor_building_blue.png',
	dragons: '/riot/ui/dragon-100.png',
	heralds: '/riot/ui/herald-100.png',
	barons: '/riot/ui/nashor.png',
	creepScore: '/riot/ui/creep.png',
	damage: '/riot/ui/statistics/attack_damage.png',
} as const;

interface Props {
	key: keyof typeof icons;
	size: 'sm' | 'md' | 'lg';
}

const { key, size } = Astro.props;
---

<img src={icons[key]} alt="" class:list={['object-contain opacity-70', size === 'sm' ? 'size-3' : size === 'md' ? 'size-4' : 'size-5']} />
