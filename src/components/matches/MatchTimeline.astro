---
import type { TimelineState } from '../../lib/stats/timelines';
import MatchTimelineView from './MatchTimelineView';

interface Props { timeline: TimelineState; matchId: string; }
const { timeline, matchId } = Astro.props;
---
<div data-match-timeline-root data-props={JSON.stringify({ timeline, matchId })}>
	<MatchTimelineView timeline={timeline} matchId={matchId} />
</div>

<script>
	import { hydrateMatchTimelines } from './MatchTimelineView';
	hydrateMatchTimelines(document);
</script>
