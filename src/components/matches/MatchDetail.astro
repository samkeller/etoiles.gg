---
import ChampionIcon from "../ui/ChampionIcon.astro";
import MeterBar from "../ui/MeterBar.astro";
import RoleIcon from "../ui/RoleIcon.astro";
import {
	formatCompact,
	formatDate,
	formatDuration,
	formatKda,
	formatKdaIndicator,
	formatTime,
} from "../../lib/format";
import type { MatchDetail, MatchTeamObjectives } from "../../lib/stats";
import UiIcon from "../ui/UiIcon.astro";
import SummonerSpell from '../ui/SummonerSpell.astro';
import StarPresence from '../ui/StarPresence.astro';
import OpggIcon from '../ui/OpggIcon.astro';
import MatchTimeline from './MatchTimeline.astro';
import type { TimelineState } from '../../lib/stats/timelines';
import type { TeamMoment } from '../../lib/stats/moments';

interface Props {
	detail: MatchDetail;
	titleId: string;
	moments?: TeamMoment[];
	timeline?: TimelineState;
}

const { detail, titleId, moments = [], timeline } = Astro.props;
const isWin = detail.outcome === "win";
const maxDamage = Math.max(
	...detail.teams.flatMap((team) =>
		team.participants.map((participant) => participant.damage),
	),
	1,
);
const objectives: {
	key: keyof MatchTeamObjectives;
	label: string;
	icon: 'towers' | 'inhibitors' | 'dragons' | 'voidgrubs' | 'heralds' | 'barons';
}[] = [
	{
		key: "towers",
		icon: 'towers',
		label: "Tours",
	},
	{
		key: "inhibitors",
		icon: 'inhibitors',
		label: "Inhib.",
	},
	{
		key: "dragons",
		icon: 'dragons',
		label: "Dragons",
	},
	{
		key: "voidgrubs",
		icon: 'voidgrubs',
		label: "Larves",
	},
	{
		key: "heralds",
		icon: 'heralds',
		label: "Héraut",
	},
	{
		key: "barons",
		icon: 'barons',
		label: "Barons",
	},
];
---

<article class="flex flex-col gap-6">
	<header
		class="flex flex-col gap-3 pr-10 sm:flex-row sm:items-end sm:justify-between"
	>
		<div>
			<p class="label-caps flex items-center gap-2 text-muted">
				{detail.queueId === 420 ? 'Classé Solo/Duo' : 'Flex'}
				<StarPresence count={detail.lineupSize} size="md" />
			</p>
			<h2
				id={titleId}
				class:list={[
					"mt-1 font-display text-4xl font-bold uppercase",
					isWin ? "text-gold-gradient" : "text-grey-300",
				]}
			>
				{isWin ? "Victoire" : "Défaite"}
			</h2>
			<p class="mt-1 text-sm text-muted">
				<time datetime={new Date(detail.startedAt).toISOString()}>
					{formatDate(detail.startedAt)} à {
						formatTime(detail.startedAt)
					}
				</time>{
					` · ${formatDuration(detail.durationS)} · patch ${detail.patch}`
				}
			</p>
		</div>
		<a
			href={detail.externalUrl}
			target="_blank"
			rel="noopener noreferrer"
			class="focus-ring label-caps inline-flex items-center gap-2 self-start border border-gold-500/60 px-3 py-2 text-gold-200 transition-colors hover:border-gold-200 hover:text-gold-100 sm:self-auto"
		>
			League of Graphs <OpggIcon name="ui-arrow-right" class="size-4"  />
		</a>
	</header>
	{moments.length > 0 && <ul aria-label="Moments marquants du match" class="flex flex-wrap gap-2">
		{moments.map((moment) => <li class="flex items-center gap-2 border border-gold-300/30 bg-gold-200/5 px-3 py-2 text-xs text-gold-100"
			data-tip={moment.matchIds.length > 1 ? `Cette partie fait partie d’une série de ${moment.matchIds.length} matchs à cinq.` : undefined}>
			{moment.champion && <ChampionIcon champion={moment.champion} size="sm" />}
			<span>{moment.title}<span class="ml-2 text-muted">{moment.value}</span></span>
		</li>)}
	</ul>}

	{
		detail.teams.map((team) => (
			<section
				aria-label={team.isOurs ? "Notre équipe" : "Équipe adverse"}
			>
				<div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2 border-b border-gold-700/60 pb-2">
					<h3 class="flex items-baseline gap-3">
						<span
							class:list={[
								"font-display text-xl font-bold",
								team.isOurs
									? "text-gold-gradient"
									: "text-grey-300",
							]}
						>
							{team.isOurs ? (detail.queueId === 420 ? "Équipe alliée" : "Les Étoiles") : "Adversaires"}
						</span>
						<span class="label-caps text-muted">
							Côté {team.side === "blue" ? "bleu" : "rouge"} ·{" "}
							{team.outcome === "win" ? "victoire" : "défaite"}
						</span>
					</h3>
					<dl class="flex flex-wrap gap-x-4 gap-y-1 text-xs">
						<div class="flex gap-1.5">
							<UiIcon key="kills" size="sm" />
							<dt class="text-muted">Kills</dt>
							<dd class="font-semibold tabular-nums text-ink">
								{team.kills}
							</dd>
						</div>
						<div class="flex gap-1.5">
							<UiIcon key="gold" size="sm" />
							<dt class="text-muted">Or</dt>
							<dd class="font-semibold tabular-nums text-ink">
								{formatCompact(team.gold)}
							</dd>
						</div>
						{objectives.map(({ key, label, icon }) => (
							<div class="flex items-center gap-1.5">
								{icon && <UiIcon key={icon} size="sm" />}
								<dt class="text-muted">{label}</dt>
								<dd class="font-semibold tabular-nums text-ink">
									{team.objectives[key]}
								</dd>
							</div>
						))}
					</dl>
				</div>

				<table class="mt-1 w-full text-sm">
					<thead class="text-xs text-muted">
						<tr>
							<th scope="col">Joueur</th>
							<th scope="col">KDA</th>
							<th scope="col" class="max-sm:hidden">CS</th>
							<th scope="col" class="max-md:hidden">Vision</th>
							<th scope="col" class="max-sm:hidden">Dégâts</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-gold-700/25">
						{team.participants.map((participant) => (
							<tr
								class:list={[
									participant.isMember && "bg-gold-700/10",
								]}
							>
								<th
									scope="row"
									class="py-2 pr-3 text-left font-normal"
								>
									<span class="flex items-center gap-3">
										<RoleIcon
											role={participant.role}
											class="size-4 opacity-70 max-sm:hidden"
										/>
										<span class="relative">
											<ChampionIcon
												champion={participant.champion}
												size="md"
												outcome={team.outcome}
												loading="eager"
											/>
											<span class="absolute -right-1 -bottom-1 grid min-w-4 place-items-center bg-night-950 px-0.5 text-[0.625rem] tabular-nums text-muted">
												{participant.championLevel}
											</span>
										</span>
										<span class="flex flex-col gap-1">
											<SummonerSpell id={participant.summonerSpells[0]} />
											<SummonerSpell id={participant.summonerSpells[1]} />
										</span>
										<span
											class:list={[
												"truncate",
												participant.isMember
													? "font-semibold text-ink"
													: "text-muted",
											]}
										>
											{participant.name}
										</span>
									</span>
								</th>
								<td class="py-2 pr-3 text-right font-semibold whitespace-nowrap tabular-nums text-ink">
									<div class="flex flex-col">
										{formatKda(
											participant.kills,
											participant.deaths,
											participant.assists,
										)}
										<span class="ml-1 text-xs text-muted">
											{formatKdaIndicator(
												participant.kills,
												participant.deaths,
												participant.assists,
											)}
											:1
										</span>
									</div>
								</td>
								<td class="py-2 pr-3 text-right tabular-nums text-muted max-sm:hidden">
									<div class="flex justify-center items-center gap-1">
										{participant.cs}
										<UiIcon key="creepScore" size="md" />
									</div>
								</td>
								<td class="py-2 pr-3 text-right tabular-nums text-muted max-md:hidden">
									<div class="flex justify-center items-center gap-1">
										{participant.vision}
										<UiIcon key="vision" size="md" />
									</div>
								</td>
								<td class="w-28 py-2 max-sm:hidden">
									<div class="flex justify-end items-center gap-1">
										<span class="block text-right text-xs tabular-nums text-muted">
											{formatCompact(participant.damage)}
										</span>
										<UiIcon key="damage" size="sm" />
									</div>
									<MeterBar
										ratio={participant.damage / maxDamage}
										class="mt-1"
									/>
								</td>
							</tr>
						))}
					</tbody>
				</table>
			</section>
		))
	}
	{timeline && <MatchTimeline timeline={timeline} />}
</article>
