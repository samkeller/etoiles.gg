---
import DraftObservations from '../collective/DraftObservations.astro';
import Panel from '../ui/Panel.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import type { Position } from '../../lib/types';
import type { TeamCollective } from '../../lib/stats';

interface Props {
	collective: TeamCollective;
	associationRoles: readonly Position[];
}

const { collective, associationRoles } = Astro.props;
---

<section aria-labelledby="collective-title">
	<SectionHeading id="collective-title" eyebrow="Collectif" title="Notre style de jeu" />
	{collective.winRate === null ? (
		<Panel as="div" class="px-6 py-10">
			<p class="text-muted">Le récit commencera avec le premier match joué à cinq.</p>
		</Panel>
	) : (
		<>
			<div class="space-y-6">
				<DraftObservations id="associations-title" title="Associations de champions et joueurs"
					observations={collective.associations} pending={collective.pendingAssociations}
					baseline={collective.winRate} minimumGames={collective.minimumGames} {associationRoles} />
				<DraftObservations id="compositions-title" title="Compositions à cinq"
					observations={collective.compositions} pending={collective.pendingCompositions}
					baseline={collective.winRate} minimumGames={collective.minimumGames} composition />
			</div>
		</>
	)}
</section>
