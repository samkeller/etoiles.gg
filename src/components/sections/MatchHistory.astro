---
import MatchRow from '../matches/MatchRow.astro';
import Disclosure from '../ui/Disclosure.astro';
import Panel from '../ui/Panel.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import OpggIcon from '../ui/OpggIcon.astro';
import { pluralize } from '../../lib/format';
import type { MatchSummary } from '../../lib/stats';

interface Props {
	fullMatches: readonly MatchSummary[];
	partialMatches: readonly MatchSummary[];
}

const RECENT_COUNT = 10;
const { fullMatches, partialMatches } = Astro.props;
const recent = fullMatches.slice(0, RECENT_COUNT);
const older = fullMatches.slice(RECENT_COUNT);
const showOlder = Astro.url.searchParams.get('history') === 'all';
const showPartial = Astro.url.searchParams.get('partial') === 'show';
const historyUrl = (key: string, value: string) => {
	const url = new URL(Astro.url);
	url.searchParams.set(key, value);
	return `${url.pathname}${url.search}#history-title`;
};
---

<section aria-labelledby="history-title">
	<SectionHeading
		id="history-title"
		eyebrow="Historique"
		title="Nos matchs à cinq"
	/>

	<Panel class="py-2">
		{
			fullMatches.length === 0 ? (
				<p class="px-5 py-10 text-center text-muted">Aucun match joué à cinq pour l'instant.</p>
			) : (
				<>
					<ol class="divide-y divide-gold-700/40">
						{recent.map((match) => (
							<li>
								<MatchRow match={match} />
							</li>
						))}
					</ol>
					{older.length > 0 && (
						<Disclosure
							summary={`Afficher ${pluralize(older.length, 'match précédent', 'matchs précédents')}`}
							class="border-t border-gold-700/40"
							open={showOlder}
							data-history-src="/partials/history?scope=full"
							data-history-loaded={showOlder ? 'true' : undefined}
						>
							<div data-history-body>
							{showOlder ? <ol class="divide-y divide-gold-700/40 border-t border-gold-700/40">
								{older.map((match) => (
									<li>
										<MatchRow match={match} />
									</li>
								))}
							</ol> : <a href={historyUrl('history', 'all')} class="focus-ring m-5 block text-sm text-hextech-300 underline">Charger les matchs précédents</a>}
							</div>
						</Disclosure>
					)}
				</>
			)
		}
	</Panel>

	{
		partialMatches.length > 0 && (
			<Disclosure
				summary={`Matchs partiels · ${partialMatches.length}`}
				hint="Parties à 2, 3 ou 4 Étoiles. Elles ne comptent dans aucune statistique d'équipe."
				class="mt-6 border border-dashed border-grey-700 bg-night-950/40"
				open={showPartial}
				data-history-src="/partials/history?scope=partial"
				data-history-loaded={showPartial ? 'true' : undefined}
			>
				<div data-history-body>
				{showPartial ? <ol class="divide-y divide-grey-700/60 border-t border-dashed border-grey-700">
					{partialMatches.map((match) => (
						<li>
							<MatchRow match={match} />
						</li>
					))}
				</ol> : <a href={historyUrl('partial', 'show')} class="focus-ring m-5 block text-sm text-hextech-300 underline">Charger les matchs partiels</a>}
				</div>
			</Disclosure>
		)
	}

	<dialog
		id="match-dialog"
		aria-label="Détail du match"
		class="m-auto max-h-[90dvh] w-[min(60rem,calc(100%-1.5rem))] overflow-visible bg-transparent p-0 text-ink backdrop:bg-night-950/80 backdrop:backdrop-blur-sm"
	>
		<Panel as="div" class="px-5 py-6 sm:px-8">
			<form method="dialog" class="absolute top-0 right-0 z-10">
				<button
					type="submit"
					class="focus-ring grid size-9 place-items-center border border-gold-500/60 bg-night-950 font-display text-xl text-gold-200 transition-colors hover:border-gold-200 hover:text-gold-100"
					aria-label="Fermer"
				>
					<OpggIcon name="ui-close" class="size-4" />
				</button>
			</form>
			<div data-dialog-body aria-live="polite" class="max-h-[calc(90dvh-4rem)] overflow-y-auto"></div>
		</Panel>
	</dialog>

	<template id="match-dialog-loading">
		<p class="label-caps animate-pulse py-16 text-center text-muted motion-reduce:animate-none">
			Chargement du match…
		</p>
	</template>
	<template id="match-dialog-error">
		<p class="pt-16 pb-4 text-center text-muted">
			Ce match n'a pas pu être chargé. Réessayez dans un instant.
		</p>
		<button type="button" data-match-retry class="focus-ring mx-auto mb-10 block border border-hextech-300/40 px-4 py-2 text-hextech-300">Réessayer</button>
	</template>
</section>

<script>
	import { createMatchLoader } from '../../lib/match-loader';
	const dialog = document.querySelector<HTMLDialogElement>('#match-dialog');
	const body = dialog?.querySelector<HTMLElement>('[data-dialog-body]');
	const loading = document.querySelector<HTMLTemplateElement>('#match-dialog-loading');
	const failure = document.querySelector<HTMLTemplateElement>('#match-dialog-error');
	const loader = createMatchLoader();
	let selectedId: string | null = null;
	let renderSequence = 0;

	function showTemplate(template: HTMLTemplateElement | null) {
		if (body && template) body.replaceChildren(template.content.cloneNode(true));
	}

	async function openMatch(matchId: string) {
		if (!dialog || !body) return;
		selectedId = matchId;
		const request = ++renderSequence;
		showTemplate(loading);
		body.setAttribute('aria-busy', 'true');
		body.scrollTop = 0;
		if (!dialog.open) dialog.showModal();

		try {
			const html = await loader.load(matchId);
			if (html !== null && request === renderSequence) {
				body.innerHTML = html;
				body.scrollTop = 0;
			}
		} catch (error) {
			if (request === renderSequence) {
				console.error('Impossible de charger le détail du match.', error);
				showTemplate(failure);
			}
		} finally {
			if (request === renderSequence) body.setAttribute('aria-busy', 'false');
		}
	}

	document.addEventListener('click', (event) => {
		if (!(event.target instanceof Element)) return;
		if (event.target.closest('[data-match-retry]') && selectedId) void openMatch(selectedId);
		const trigger = event.target.closest<HTMLElement>('[data-match-id]');
		if (trigger?.dataset.matchId) void openMatch(trigger.dataset.matchId);
	});

	dialog?.addEventListener('click', (event) => {
		if (event.target === dialog) dialog.close();
	});

	dialog?.addEventListener('close', () => {
		if (dialog.open) return;
		selectedId = null;
		renderSequence += 1;
		loader.cancel();
		body?.setAttribute('aria-busy', 'false');
	});

	for (const disclosure of document.querySelectorAll<HTMLDetailsElement>('[data-history-src]')) {
		const listBody = disclosure.querySelector<HTMLElement>('[data-history-body]');
		const source = disclosure.dataset.historySrc;
		if (!listBody || !source) continue;
		let loadingList = false;
		const loadList = async () => {
			if (loadingList || disclosure.dataset.historyLoaded === 'true') return;
			loadingList = true;
			listBody.setAttribute('aria-busy', 'true');
			const status = document.createElement('p');
			status.className = 'm-5 text-sm text-muted';
			status.textContent = 'Chargement des matchs…';
			listBody.prepend(status);
			try {
				const response = await fetch(source);
				if (!response.ok) throw new Error(`Historique : HTTP ${response.status}`);
				listBody.innerHTML = await response.text();
				disclosure.dataset.historyLoaded = 'true';
			} catch (error) {
				console.error('Impossible de charger l’historique.', error);
				status.textContent = 'Chargement impossible. Utilisez le lien ci-dessous pour réessayer.';
			} finally {
				listBody.setAttribute('aria-busy', 'false');
				loadingList = false;
			}
		};
		disclosure.addEventListener('toggle', () => {
			if (disclosure.open) void loadList();
		});
	}
</script>
