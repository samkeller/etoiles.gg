---
import FormStrip from '../ui/FormStrip.astro';
import ChampionIcon from '../ui/ChampionIcon.astro';
import OpggIcon from '../ui/OpggIcon.astro';
import { formatDate, formatPercent, pluralize } from '../../lib/format';
import type { TeamOverview as Overview, MatchSummary, TeamSession } from '../../lib/stats';
import { TEAM_NAME } from '../../lib/site';

interface Props {
	overview: Overview;
	recentMatches: readonly MatchSummary[];
	latestSession: TeamSession | null;
}

const { overview, recentMatches, latestSession } = Astro.props;
const latestMatch = latestSession?.matches[0] ?? null;
const winPercent = overview.winRate === null ? null : formatPercent(overview.winRate);
const streakLabel = overview.currentStreak.result === 'win' ? 'victoires' : 'défaites';
const [teamNameLead, teamNameRest = ''] = TEAM_NAME.split(' de ');
---

<section id="team-title" aria-labelledby="team-name" class="relative isolate overflow-hidden border-y border-white/10 py-10 sm:py-16">
	<div aria-hidden="true" class="pointer-events-none absolute -top-20 right-[8%] -z-10 size-72 rounded-full bg-hextech-300/5 blur-3xl"></div>
	<div class="mx-auto grid max-w-7xl gap-10 px-4 sm:px-8 lg:grid-cols-[minmax(0,1.3fr)_minmax(18rem,0.7fr)] lg:items-end lg:gap-16">
		<div class="max-w-3xl">
			<p class="label-caps flex items-center gap-3 text-hextech-300">
				<span class="h-px w-8 bg-hextech-300/70" aria-hidden="true"></span>
				Le carnet de bord
			</p>
			<h1 id="team-name" class="mt-6 font-display text-5xl leading-[0.98] font-medium tracking-tight text-ink sm:text-7xl">
				{teamNameLead}<br />
				<span class="text-gold-200">de {teamNameRest}</span>
			</h1>
			<p class="mt-6 max-w-xl font-display text-xl leading-relaxed text-grey-300 sm:text-2xl">
				Cinq amis, une constellation de parties. Un lieu pour comprendre notre jeu, préparer la suite et garder les bons souvenirs.
			</p>
			<p class="mt-5 flex items-center gap-1 text-sm font-medium tracking-wide text-gold-200">Fait à cinq, pour les cinq. <OpggIcon name="star" class="size-3.5" /></p>

			<div class="mt-10 flex flex-wrap items-center gap-x-8 gap-y-3">
				<a href="/history" class="focus-ring inline-flex items-center gap-3 border-b border-gold-200/50 pb-2 text-sm text-ink transition-colors hover:border-gold-100">
					Parcourir notre histoire <OpggIcon name="ui-arrow-right" class="size-4"  />
				</a>
				<a href="/draft" class="focus-ring inline-flex items-center gap-3 border-b border-hextech-300/50 pb-2 text-sm text-hextech-300 transition-colors hover:border-hextech-300">
					Préparer une composition <OpggIcon name="ui-arrow-right" class="size-4"  />
				</a>
			</div>
		</div>

		<aside aria-label="Dernier alignement des étoiles" class="relative border-l border-white/15 py-2 pl-6 sm:pl-8">
			<p class="label-caps text-muted">Dernier alignement des étoiles</p>
			{
				latestSession && latestMatch ? (
					<>
						<p class="mt-3 font-display text-2xl text-ink">{formatDate(latestSession.startedAt)}</p>
						<p class="mt-2 text-sm text-muted">
							{pluralize(latestSession.matches.length, 'match')} · {latestSession.wins} victoire{latestSession.wins === 1 ? '' : 's'} · {latestSession.losses} défaite{latestSession.losses === 1 ? '' : 's'}
						</p>
						<a href={`/matches/${latestMatch.id}`} class="focus-ring mt-5 flex items-center justify-between gap-4 border-t border-white/10 pt-4 text-sm">
							<span class="flex items-center gap-2">
								<span class:list={['size-2 rotate-45', latestMatch.outcome === 'win' ? 'bg-win shadow-glow-gold' : 'bg-loss']} aria-hidden="true"></span>
								<span class="text-ink">{latestMatch.outcome === 'win' ? 'La dernière s’est terminée par une victoire' : 'La dernière s’est terminée par une défaite'}</span>
							</span>
							<OpggIcon name="ui-arrow-right" class="size-3 -rotate-45 text-muted" />
						</a>
						<div class="mt-4 flex gap-2" aria-label="Champions de la dernière partie">
							{latestMatch.members.map((member) => <ChampionIcon champion={member.champion} size="sm" />)}
						</div>
					</>
				) : (
					<p class="mt-3 max-w-sm text-sm leading-relaxed text-muted">
						La constellation attend sa première partie complète. Les statistiques collectives ne s’affichent qu’avec les cinq joueurs réunis.
					</p>
				)
			}
		</aside>
	</div>

	<div class="mx-auto mt-12 grid max-w-7xl gap-8 border-t border-white/10 px-4 pt-7 sm:px-8 md:grid-cols-[minmax(0,1fr)_auto] md:items-end">
		{
			overview.matchCount > 0 ? (
				<>
					<div>
						<div class="flex flex-wrap items-baseline justify-between gap-3">
							<p class="label-caps text-muted">Forme collective · {pluralize(overview.recentForm.length, 'dernier match', 'derniers matchs')}</p>
							<p class="text-sm text-muted">
								Série active : <span class="font-semibold text-ink">{overview.currentStreak.count} {streakLabel}</span>
							</p>
						</div>
						<FormStrip matches={recentMatches} streakCount={overview.currentStreak.count} class="mt-4" />
					</div>
					<dl class="grid grid-cols-3 gap-x-6 gap-y-3 md:border-l md:border-white/10 md:pl-8">
						<div>
							<dt class="label-caps text-[0.6rem] text-muted">Matchs à cinq</dt>
							<dd class="mt-1 font-display text-2xl tabular-nums text-ink">{overview.matchCount}</dd>
						</div>
						<div>
							<dt class="label-caps text-[0.6rem] text-muted">Victoires</dt>
							<dd class="mt-1 font-display text-2xl tabular-nums text-gold-200">{winPercent}</dd>
						</div>
						<div>
							<dt class="label-caps text-[0.6rem] text-muted">Meilleure série</dt>
							<dd class="mt-1 font-display text-2xl tabular-nums text-ink">{overview.bestWinStreak}</dd>
						</div>
					</dl>
				</>
			) : (
				<p class="text-sm leading-relaxed text-muted">
					Les données de l’équipe apparaîtront ici après une soirée jouée à cinq en Flex. Les parties incomplètes restent à part.
				</p>
			)
		}
	</div>
</section>
