---
import PlayerCard from '../players/PlayerCard.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import MotionItem from '../ui/MotionItem.astro';
import type { PlayerProfile } from '../../lib/stats';

interface Props {
	players: readonly PlayerProfile[];
}

const { players } = Astro.props;
---

<section aria-labelledby="roster-title">
	<SectionHeading
		id="roster-title"
		eyebrow="Joueurs"
		title="Les cinq Étoiles"
	/>
	{
		players.length === 0 ? (
			<p class="text-muted">Aucun joueur enregistré pour l'instant.</p>
		) : (
			<ul class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5">
				{players.map((player, index) => (
					<MotionItem as="li" index={index}>
						<PlayerCard player={player} />
					</MotionItem>
				))}
			</ul>
		)
	}
</section>
