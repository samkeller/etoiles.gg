---
import '../styles/global.css';
import { SITE_NAME, TEAM_NAME } from '../lib/site';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = `${TEAM_NAME} — ${SITE_NAME}`,
	description = `Le carnet de bord de ${TEAM_NAME} : nos matchs joués à cinq.`,
} = Astro.props;
---

<!doctype html>
<html lang="fr">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<title>{title}</title>
		<link rel="icon" href="/favicon/favicon.ico" sizes="any" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon/favicon-32x32.png" />
		<link rel="apple-touch-icon" href="/favicon/apple-touch-icon.png" />
	</head>
	<body
		class="relative isolate min-h-dvh bg-night-950 font-body text-ink antialiased before:pointer-events-none before:fixed before:inset-0 before:-z-10 before:bg-[url(/riot/background.png)] before:bg-cover before:bg-center before:bg-no-repeat before:content-['']"
	>
		<slot />
	</body>
</html>
